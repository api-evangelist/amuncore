{
  "opencollection": "1.0.0",
  "info": {
    "name": "AmunCore API Engine: Dynamic API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
